{
  "compilerOptions": {
    "allowJs": false,
    "lib": [
      "ES2024"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "types": [
      "astro/client",
      "@cloudflare/vitest-plugin/types"
    ]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.astro",
    "test/**/*.ts",
    "vitest.config.ts",
    "worker-configuration.d.ts"
  ]
}
