{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "architecture-tokens-website",
  "main": "./src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "architecturetokens.org",
      "custom_domain": true
    },
    {
      "pattern": "www.architecturetokens.org",
      "custom_domain": true
    },
    {
      "pattern": "architecturetokens.com",
      "custom_domain": true
    },
    {
      "pattern": "www.architecturetokens.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "invocation_logs": true
    }
  }
}
